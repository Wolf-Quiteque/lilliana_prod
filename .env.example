ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-at-least-32-random-characters
PORT=3000

# Cloudflare R2 image storage. R2_ENDPOINT is optional when R2_ACCOUNT_ID is set.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=lillis-productions-media
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://media.example.com

# Required only for Vercel: private CMS content and lead CRM storage.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
