# MongoDB Atlas — holds the site content, versions, media list and the admin account
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGODB_DB=Lilli

# Cloudflare R2 — uploaded images and videos (everything is stored under lilli/)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Admin login. ADMIN_EMAIL / ADMIN_PASSWORD only create the account on the very first sign-in;
# after that the password lives (hashed) in the database and is changed from the editor.
AUTH_SECRET=at-least-32-random-characters
ADMIN_EMAIL=hello@lillisproductions.com
ADMIN_PASSWORD=
